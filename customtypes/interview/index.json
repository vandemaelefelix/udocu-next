{
  "id": "interview",
  "label": "Interview",
  "repeatable": true,
  "status": true,
  "format": "custom",
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID"
        }
      },
      "name": {
        "type": "Text",
        "config": {
          "label": "Name",
          "placeholder": "Interviewee name"
        }
      },
      "publish_date": {
        "type": "Date",
        "config": {
          "label": "Publish Date"
        }
      },
      "image_url": {
        "type": "Image",
        "config": {
          "label": "Thumbnail Image",
          "constraint": { "width": 1000, "height": 1000 },
          "thumbnails": []
        }
      },
      "video_url": {
        "type": "Link",
        "config": {
          "label": "YouTube URL",
          "placeholder": "https://www.youtube.com/watch?v=...",
          "allowTargetBlank": false,
          "select": "web"
        }
      }
    }
  }
}
